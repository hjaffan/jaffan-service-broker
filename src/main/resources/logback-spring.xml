<?xml version="1.0" encoding="UTF-8"?>
<!--
  Single-line, structured logging to stdout. CF's log drain captures stdout, and the OperationLog
  records are already key=value, so this pattern keeps one event per line and never adds a body that
  could carry a secret. No file appenders: containers are ephemeral.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{40} - %replace(%msg){'[\r\n]+', ' '}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
